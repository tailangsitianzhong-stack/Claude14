{
  // ゲーム本体(静的ファイル)の公開用。Cloudflare の「Workers Builds」で使う。
  // ビルドコマンド: mkdir -p public && cp -r index.html css js data public/
  // デプロイコマンド: npx wrangler deploy
  // (判定用のWorkerは worker/wrangler.jsonc で別にデプロイ)
  "name": "minigame",
  "compatibility_date": "2026-10-01",
  // 公開するファイルを public/ に集める(デプロイのたびに実行される)。
  // ダッシュボードのビルドコマンドが古くても、新しいファイル(assets/ や manifest)が漏れないようにここに書く
  "build": { "command": "mkdir -p public && cp -r index.html manifest.webmanifest css js data assets public/" },
  "assets": { "directory": "./public" }
}
