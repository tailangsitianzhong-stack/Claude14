{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiritori-judge",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",

  "vars": {
    // 使うGeminiモデル。無料枠で使えるものを AI Studio / 公式の料金表で確認して指定する
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // ゲームを開いているページのオリジン(カンマ区切り)。公開したらそのURLを足す。
    // "null" は index.html をファイルで直接開いた時(file://)用。公開時は消してよい
    "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080,null"
  },

  // 判定結果のキャッシュ(Workers KV)。idを書かなくても deploy 時に自動で作られる
  "kv_namespaces": [{ "binding": "CACHE" }]
}
