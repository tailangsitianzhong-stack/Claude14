{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiritori-judge",
  "main": "main.mjs",
  "compatibility_date": "2026-10-01",

  "vars": {
    // 使うGeminiモデル。無料枠で使えるものを AI Studio / 公式の料金表で確認して指定する
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // ゲームを開いているページのオリジン(カンマ区切り)。公開したらそのURLを足す。
    // 1つ目はゲームの公開URL。localhost はパソコンで試す時用
    "ALLOWED_ORIGINS": "https://minigame.tailangsitianzhong.workers.dev,http://localhost:8080,http://127.0.0.1:8080"
  },

  // 判定結果のキャッシュ(Workers KV)。idを書かなくても deploy 時に自動で作られる
  "kv_namespaces": [{ "binding": "CACHE" }],

  // 友達対戦の「部屋」(Durable Object)。無料プランは SQLite 版だけ使える
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
